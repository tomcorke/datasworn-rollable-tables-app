{
  "name": "datasworn-rollable-tables-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test-tools": "node test-tools/server.mjs",
    "data:build": "node scripts/build-data.mjs",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format:css": "prettier --write \"src/**/*.css\"",
    "format:css:check": "prettier --check \"src/**/*.css\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test-tools/**/*.{js,mjs}\" \"scripts/**/*.{js,mjs}\" \"*.{js,mjs,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"test-tools/**/*.{js,mjs}\" \"scripts/**/*.{js,mjs}\" \"*.{js,mjs,ts,json}\""
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "yaml": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "prettier": "^3.9.6",
    "puppeteer": "^25.8.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "latest"
  }
}
